generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

//////////////////////////////////////////////////////
// TEMPLATE
//////////////////////////////////////////////////////

model CountryTemplate {
  id            String         @id @default(cuid())
  name          String         @unique
  cities        CityTemplate[]
  gameCountries GameCountry[]
}

model CityTemplate {
  id   String @id @default(cuid())
  name String

  country   CountryTemplate @relation(fields: [countryId], references: [id])
  countryId String

  order           Int        @default(0)
  baseLife        Int
  baseDevelopment Int
  gameCities      GameCity[]

  @@unique([name, countryId])
}

//////////////////////////////////////////////////////
// GAME
//////////////////////////////////////////////////////

enum GamePhase {
  LOBBY
  WAITING_COUNTRY
  COUNTRY_MANAGEMENT
  WAITING_UN
  UN_STATS
  RESULTS
}

model Game {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ecology   Float     @default(90)
  round     Int       @default(1)
  maxRounds Int       @default(5)
  phase     GamePhase @default(LOBBY)

  joinCode String @unique

  roundStartedAt DateTime?
  roundDuration  Int       @default(600)

  isPaused Boolean   @default(false)
  pausedAt DateTime?

  hostId String
  host   Player @relation(fields: [hostId], references: [id])

  teams     Team[]
  countries GameCountry[]
  cities    GameCity[]
  players   GamePlayer[]
  sanctions Sanction[]
  gameTurns GameTurn[]
}

model GameTurn {
  id String @id @default(cuid())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  countryId String
  country   GameCountry @relation(fields: [countryId], references: [id])

  round Int

  sendedMoney         String @default("")
  updatedCities       String @default("")
  attackedCities      String @default("")
  protectedCities     String @default("")
  sanctionedCountries String @default("")  

  nuclearTechnology Boolean @default(false)
  buildNukes        Int     @default(0)
  ecoProgram        Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([gameId, countryId, round])
}

//////////////////////////////////////////////////////
// GAME PLAYER ⭐
//////////////////////////////////////////////////////

model GamePlayer {
  id String @id @default(cuid())

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  player   Player @relation(fields: [playerId], references: [id])
  playerId String

  // null = в комнате ожидания
  country   GameCountry? @relation(fields: [countryId], references: [id])
  countryId String?

  isPresident Boolean @default(false)

  team   Team?   @relation(fields: [teamId], references: [id])
  teamId String?

  joinedAt DateTime @default(now())

  @@unique([gameId, playerId])
}

//////////////////////////////////////////////////////
// COUNTRY IN GAME
//////////////////////////////////////////////////////

model GameCountry {
  id String @id @default(cuid())

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  template   CountryTemplate @relation(fields: [templateId], references: [id])
  templateId String

  isActive          Boolean @default(true)
  budget            Float   @default(1000)
  nukes             Int     @default(0)
  hasNuclearProgram Boolean @default(false)

  team   Team?   @relation(fields: [teamId], references: [id])
  teamId String?

  players GamePlayer[]

  cities    GameCity[]
  gameTurns GameTurn[]

  sanctionsFrom Sanction[] @relation("fromCountry")
  sanctionsTo   Sanction[] @relation("toCountry")

  @@unique([gameId, templateId])
}

//////////////////////////////////////////////////////
// CITY
//////////////////////////////////////////////////////

model GameCity {
  id String @id @default(cuid())

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  template   CityTemplate @relation(fields: [templateId], references: [id])
  templateId String

  country   GameCountry @relation(fields: [countryId], references: [id])
  countryId String

  life        Float
  development Float

  protection Int @default(1)

  @@unique([gameId, templateId])
}

//////////////////////////////////////////////////////
// TEAM
//////////////////////////////////////////////////////

model Team {
  id String @id @default(cuid())

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  money Float @default(0)

  hasBombProgram Boolean @default(false)
  bombsCount     Int     @default(0)

  players   GamePlayer[]
  countries GameCountry[]
}

//////////////////////////////////////////////////////
// PLAYER
//////////////////////////////////////////////////////

model Player {
  id   String @id @default(cuid())
  name String

  games GamePlayer[]

  hostedGames Game[]
}

//////////////////////////////////////////////////////
// SANCTIONS
//////////////////////////////////////////////////////

model Sanction {
  id String @id @default(cuid())

  fromCountry   GameCountry @relation("fromCountry", fields: [fromCountryId], references: [id])
  fromCountryId String

  toCountry   GameCountry @relation("toCountry", fields: [toCountryId], references: [id])
  toCountryId String

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  @@unique([fromCountryId, toCountryId, gameId])
}
